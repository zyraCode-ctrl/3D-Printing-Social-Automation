# =============================================================================
# 3D Printing Store Social Automation — environment template
# Copy to .env and fill in values. Never commit .env.
# scripts/setup_env.py creates .env with generated secrets if it does not exist.
# =============================================================================

# --- n8n ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata
N8N_ENCRYPTION_KEY=replace-with-32-plus-random-characters
N8N_SECURE_COOKIE=false
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_RESTRICT_FILE_ACCESS_TO=/data
N8N_OWNER_EMAIL=admin@localhost.local
N8N_OWNER_FIRST_NAME=Store
N8N_OWNER_LAST_NAME=Admin
N8N_OWNER_PASSWORD=replace-with-strong-password

# --- Safety (keep true until you explicitly approve live publishing) ---
DRY_RUN=true
USE_SAMPLE_MEDIA=false
# The daily publishing time is NOT set here. Pick it on http://localhost:8081/dashboard
# (Schedule settings); it is saved to config/schedule.json, the single source of truth.

# --- Google Drive ---
GOOGLE_DRIVE_FOLDER_ID=
# public = list/download shared folder without n8n Drive OAuth
DRIVE_ACCESS_MODE=public

# --- Meta (Facebook Page + Instagram) ---
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_GRAPH_VERSION=v22.0

# Optional notes (values go in n8n Credentials → Facebook Graph account, not here):
# META_PAGE_ACCESS_TOKEN is pasted only inside n8n — never commit it.
# Required Graph scopes for IG+FB publishing:
#   pages_show_list, pages_read_engagement, pages_manage_posts,
#   instagram_basic, instagram_content_publish

# --- Pinterest (official API v5; image Pins only) ---
PINTEREST_BOARD_ID=
# Optional: inject OAuth *client* fields into n8n credential on import (never commit real values).
# Complete "Connect my account" only inside n8n UI — never paste tokens into chat.
# PINTEREST_OAUTH_CLIENT_ID=
# PINTEREST_OAUTH_CLIENT_SECRET=
# Required OAuth scopes (space- or comma-separated in n8n OAuth2 credential):
#   user_accounts:read boards:read boards:write pins:read pins:write
# Redirect URI for the Pinterest developer app:
#   http://localhost:5678/rest/oauth2-credential/callback

# --- YouTube Shorts only (never long-form) ---
YOUTUBE_PRIVACY_STATUS=private
# Optional: inject OAuth *client* fields into n8n credential on import (never commit real values).
# Complete "Sign in with Google" only inside n8n UI — never paste tokens into chat.
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
# Required OAuth scopes (handled by n8n YouTube OAuth2 credential / consent screen):
#   https://www.googleapis.com/auth/youtube.upload
#   https://www.googleapis.com/auth/youtube.readonly
# Redirect URI for Web client:
#   http://localhost:5678/rest/oauth2-credential/callback

# --- Website (leave empty until the store is ready) ---
WEBSITE_URL=
INCLUDE_WEBSITE_URL=false

# --- AI provider (Gemini free tier via n8n credential; ChatGPT Pro is not used) ---
# gemini | ollama  (mock and OpenAI API are not used on the production path)
# Paste the Gemini key in n8n → Credentials → Google Gemini account. Do not put it here.
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
GEMINI_HOST=https://generativelanguage.googleapis.com
# Fallback when every Gemini model fails: groq | none. Same prompt/schema, one call for all 4 platforms.
# Groq key goes in n8n → Credentials → Groq account (Header Auth: Authorization = Bearer <key>).
# Optional: set GROQ_API_KEY here (local, never commit) or as a GitHub secret and
# scripts/import_workflows.py fills that credential for you. See docs/GROQ_FALLBACK_SETUP.md.
AI_FALLBACK_PROVIDER=groq
GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llava

# --- Tracking API (internal SQLite helper used by n8n + dashboard + scheduler) ---
TRACKING_API_PORT=8081
# The tracking-api scheduler triggers 01 Daily Publisher at the dashboard time and keeps
# the 3-product queue prepared. Set false only if something else must own the schedule.
SCHEDULER_ENABLED=true
# Optional: push dashboard schedule changes to GitHub so GitHub Actions follows the same time.
# Fine-grained token, this repository only, permission "Contents: Read and write".
# See docs/DASHBOARD.md. Never commit a real value.
GITHUB_SYNC_TOKEN=
GITHUB_REPOSITORY=
GITHUB_BRANCH=main
