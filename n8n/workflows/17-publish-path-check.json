    {
      "id": "66514d9a-12a3-5340-8287-21748c81c3ac",
      "name": "Pick Queue Head",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const q = $json;\nconst head = q.head || (q.active || []).find((r) => r.status === 'prepared');\nif (!head) throw new Error('No prepared product in the queue to validate');\nreturn [{ json: { product_id: head.product_id, filename: head.filename, validate_only: true } }];\n"
      }
    },
    {
      "id": "85bca3e9-5738-5df2-85de-2edadbbf4384",
      "name": "Ensure Media",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        550,
        160
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://tracking-api:8081/products/' + $json.product_id + '/ensure-media' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "4a25206c-d7d6-5e9c-bf34-4769090987f3",
