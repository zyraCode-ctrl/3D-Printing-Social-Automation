    {
      "id": "23d5fd88-1203-5d6b-a106-e1c97786a7ae",
      "name": "IG Status Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        0
      ],
      "parameters": {
        "jsCode": "const errText = (r) => r && r.error ? String(r.error.description || r.error.message || JSON.stringify(r.error)).slice(0, 400) : null;\nconst created = $('IG Create Container').first().json;\nconst upload = $('IG Upload').first().json;\nconst status = $json;\nconst attempt = $runIndex;\nconst firstErr = errText(created) || (created.id ? null : 'Container create returned no id') || errText(upload) || errText(status);\nif (firstErr) return [{ json: { state: 'fail', error: firstErr } }];\nconst code = String(status.status_code || '');\nif (code === 'FINISHED') return [{ json: { state: 'ready', attempt } }];\nif (code === 'ERROR' || code === 'EXPIRED') return [{ json: { state: 'fail', error: 'Instagram processing ' + code + ': ' + (status.status || '') } }];\nif (attempt >= 30) return [{ json: { state: 'fail', error: 'Instagram processing timed out (' + code + ')' } }];\nreturn [{ json: { state: 'wait', attempt, status_code: code } }];\n"
      }
