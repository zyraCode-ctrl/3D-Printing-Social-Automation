    {
      "id": "593f4fcf-af76-528c-9b37-f6e6496e4b68",
      "name": "IG Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3000,
        0
      ],
      "parameters": {
        "jsCode": "const errText = (r) => r && r.error ? String(r.error.description || r.error.message || JSON.stringify(r.error)).slice(0, 400) : null;\nconst job = $('Prepare Live Job').first().json;\nif (!job.do_instagram) {\n  if (job.existing_post_ids.instagram) {\n    return [{ json: { product_id: job.product_id, platform: 'instagram', status: 'published', post_id: job.existing_post_ids.instagram, url: null, skipped_already_published: true } }];\n  }\n  return [{ json: { product_id: job.product_id, platform: 'instagram', status: 'not_in_this_test', skip_record: true } }];\n}\n\nconst gate = $('IG Status Gate').last().json;\nlet pub = null;\nlet link = null;\ntry { pub = $('IG Publish').first().json; } catch (e) {}\ntry { link = $('IG Permalink').first().json; } catch (e) {}\nconst base = { product_id: $('Prepare Live Job').first().json.product_id, platform: 'instagram' };\nif (gate.state !== 'ready') return [{ json: { ...base, status: 'failed', error_message: gate.error } }];\nif (!pub || pub.error || !pub.id) return [{ json: { ...base, status: 'failed', error_message: errText(pub) || 'media_publish returned no id' } }];\nreturn [{ json: { ...base, status: 'published', post_id: pub.id, url: (link && link.permalink) || null } }];\n"
      }
    },
