{
  "id": "3dprQueuePrep016",
  "name": "16 Content Queue Preparer",
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "id": "26251192-08f4-5e4c-b914-febc8644f448",
      "name": "Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -440,
        -40
      ],
      "parameters": {
        "content": "## Content Queue Preparer\nPrepares ONE product per run: public Google Drive folder \u2192 download media \u2192 Gemini vision AI (Groq fallback) \u2192 saved preview marked `prepared` in the queue.\n\nStarted by the tracking-api scheduler whenever fewer than `queue_size` (default 3) products are ready, and by the Daily Publisher when the queue is empty.\n\nNever publishes anything.",
        "width": 320,
        "height": 340,
        "color": 6
      }
    },
    {
      "id": "6eee46d0-4ad7-5e6d-866d-d5107528aca9",
      "name": "Run Manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "parameters": {}
    },
    {
      "id": "801dbe49-119a-5935-8f83-2e86bdf707c6",
      "name": "When Called by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        400
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "ebea9891-6226-528a-a173-94116bb5fd1b",
      "name": "Load Config",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        280,
