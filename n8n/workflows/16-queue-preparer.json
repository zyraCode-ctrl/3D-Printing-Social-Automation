      ],
      "parameters": {
        "method": "GET",
        "url": "http://tracking-api:8081/config",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "e5383093-563d-5a3e-89ab-f618930a3114",
      "name": "Drive Folder Configured?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        760,
        160
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "b21744d4-6dd5-5abe-95d8-0a16fa0d5107",
              "leftValue": "={{ $('Load Config').first().json.google_drive_folder_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "e714ecc5-4e5a-5134-b8db-fddd32a21d5c",
      "name": "Stop Missing Folder ID",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1000,
        360
      ],
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "GOOGLE_DRIVE_FOLDER_ID is empty. Paste the folder ID from the Drive URL into .env, restart Compose, then connect Google Drive OAuth in n8n."
      }
    },
    {
      "id": "77aa2219-d1d4-5013-bfc6-19478ea80378",
      "name": "List Google Drive Folder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1000,
        40
      ],
      "parameters": {
        "method": "POST",
        "url": "http://tracking-api:8081/drive/public-list",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ folder_id: $('Load Config').first().json.google_drive_folder_id }) }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "690b2af0-eb79-5ca0-a31b-55223d735f71",
      "name": "Normalize Drive List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        40
      ],
      "parameters": {
        "jsCode": "const payload = $json;\nconst files = (payload.files || []).map((item) => ({\n  name: item.name,\n  id: item.id || item.drive_file_id,\n  drive_file_id: item.drive_file_id || item.id,\n  mimeType: item.mimeType,\n  thumbnailLink: item.thumbnailLink,\n  webViewLink: item.webViewLink,\n})).filter((file) => file.name && file.drive_file_id);\nif (!files.length) {\n  throw new Error('Google Drive returned no files from the public folder. Confirm sharing is Anyone with the link and GOOGLE_DRIVE_FOLDER_ID is correct.');\n}\nreturn [{ json: { files, drive_access_mode: payload.access_mode || 'public', drive_list_method: payload.method } }];\n"
      }
    },
    {
      "id": "c4fb807d-d29f-514d-a7a3-f7c6a218438c",
      "name": "Select Next Product",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1480,
        40
      ],
      "parameters": {
        "method": "POST",
        "url": "http://tracking-api:8081/queue/select-to-prepare",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ files: $json.files || [] }) }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "758cf06b-c8b6-5f64-93a4-3929c992c2e9",
      "name": "Needs AI Content?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1720,
        40
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "a980048b-2d92-5491-8e6b-ca2d80f301a6",
              "leftValue": "={{ $json.found === true && $json.reused !== true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "4c9b3936-1f56-5719-9f47-022699db8b7c",
      "name": "Nothing To Prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1960,
        280
      ],
      "parameters": {
        "jsCode": "const s = $json;\nreturn [{ json: {\n  prepared: s.reused === true,\n  reused: s.reused === true,\n  product_id: s.product_id || null,\n  reason_code: s.reason_code || (s.reused ? 'reused_saved_content' : null),\n  reason: s.reason || (s.reused ? 'Reused saved content for Product ' + s.product_id : null),\n  queue: s.queue || []\n} }];\n"
      }
    },
    {
      "id": "b0b94817-b56b-5a99-b686-65acf60f815f",
      "name": "Pick Vision File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        -80
      ],
      "parameters": {
        "jsCode": "const selected = $('Select Next Product').first().json;\nconst config = $('Load Config').first().json;\nconst vision = selected.image_file || selected.video_file;\nif (!vision || !vision.drive_file_id) {\n  throw new Error('Product ' + selected.product_id + ' has no Google Drive file ID. Check the filename pattern ProductID.ext.');\n}\nreturn [{ json: {\n  ...selected,\n  config,\n  vision_file: vision,\n  filename: vision.filename,\n  drive_file_id: vision.drive_file_id,\n  local_path: '/data/media/' + vision.filename\n} }];\n"
      }
    },
    {
      "id": "c12fd688-5a32-5a0c-8066-5bfb7bf7c5df",
      "name": "Download Drive Media",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2440,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "http://tracking-api:8081/drive/public-download",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ file_id: $json.drive_file_id, filename: $json.filename, folder_id: $('Load Config').first().json.google_drive_folder_id }) }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "17e05c5c-ec00-5e17-97ca-540a0a3e2c7a",
      "name": "Save Media to Disk",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2680,
        -80
      ],
      "parameters": {
        "jsCode": "const picked = $('Pick Vision File').first().json;\nconst downloaded = $json;\nif (!downloaded.ok || !downloaded.local_path) {\n  throw new Error('Public Drive download failed: ' + JSON.stringify(downloaded).slice(0, 400));\n}\nreturn [{ json: { ...picked, local_path: downloaded.local_path, download_bytes: downloaded.bytes, drive_access_mode: downloaded.access_mode || 'public' } }];\n"
      }
    },
    {
      "id": "c9c26127-a343-5cd6-99a2-36ef4e91cf54",
      "name": "Prepare Vision Still",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2920,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "http://tracking-api:8081/media/prepare-vision",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ local_path: $json.local_path, media_kind: $json.vision_file.media_kind, product_id: $json.product_id }) }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "4c6dff5e-2d8e-52ea-a3aa-657c2771600c",
      "name": "Build AI Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3160,
        -80
      ],
      "parameters": {
        "jsCode": "const selected = $('Pick Vision File').first().json;\nconst vision = $json;\nif (!vision.base64) {\n  throw new Error('Could not prepare a still image for AI vision: ' + JSON.stringify(vision).slice(0, 400));\n}\nreturn [{ json: {\n  ...selected,\n  vision_base64: vision.base64,\n  vision_mime: vision.mime_type || 'image/jpeg',\n  vision_source: vision.source,\n  local_path: selected.local_path\n} }];\n"
      }
    },
    {
      "id": "14b772ac-100f-5ece-b7a0-cfd624830588",
      "name": "Generate AI Content",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        3400,
        -80
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "3dprAiContent003",
          "mode": "id",
          "cachedResultName": "03 AI Content Generator"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "c1c8cd74-d9a7-5d95-a5c3-a52b3005d9b4",
      "name": "Build Preview Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3520,
        -80
      ],
      "parameters": {
        "jsCode": "const ai = $('Generate AI Content').first().json;\nconst src = ai || $json;\nconst picked = $('Pick Vision File').first().json;\nconst config = $('Load Config').first().json;\nif (src.error && !src.content) {\n  throw new Error('AI step failed before preview save: ' + String(src.error));\n}\nif (!src.content) {\n  throw new Error('Generate AI Content returned no content object. Refusing to save preview.');\n}\nconst dryRun = !!(src.config && typeof src.config.dry_run !== 'undefined'\n  ? src.config.dry_run\n  : config.dry_run);\nconst productId = src.product_id || picked.product_id;\nconst previewBody = {\n  product_id: productId,\n  filename: src.filename || picked.filename || null,\n  media_type: src.media_type || picked.media_type || null,\n  drive_file_id: src.drive_file_id || picked.drive_file_id || null,\n  google_drive_folder_id: (src.config && src.config.google_drive_folder_id)\n    || config.google_drive_folder_id\n    || null,\n  local_path: src.local_path || picked.local_path || null,\n  vision_notes: src.vision_notes || null,\n  vision_source: src.vision_source || null,\n  ai_provider_used: src.ai_provider_used || null,\n  ai_model_used: src.ai_model_used || null,\n  gemini_model_used: src.gemini_model_used || null,\n  ai_fallback_reason: src.ai_fallback_reason || null,\n  dry_run: dryRun,\n  queue: true,\n  content: src.content,\n};\nreturn [{ json: { ...src, product_id: productId, dry_run: dryRun, previewBody } }];\n"
      }
    },
    {
      "id": "433d5ff2-b732-5db7-b358-b79c3fde4436",
      "name": "Save Preview",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        3640,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "http://tracking-api:8081/previews",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.previewBody) }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "5acb5326-86c2-50fc-9904-1297f6e03092",
      "name": "Prepared Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3880,
        -80
      ],
      "parameters": {
        "jsCode": "const saved = $json;\nconst ai = $('Generate AI Content').first().json;\nreturn [{ json: {\n  prepared: true,\n  reused: false,\n  product_id: saved.product_id,\n  filename: saved.filename,\n  ai_provider_used: ai.ai_provider_used || null,\n  ai_model_used: ai.ai_model_used || null,\n  ai_fallback_reason: ai.ai_fallback_reason || null\n} }];\n"
      }
    },
    {
      "id": "0fbfd3eb-8f3d-5540-801b-b1fa77134dc8",
      "name": "Drive",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1000,
        220
      ],
      "parameters": {
        "content": "## Google Drive (public folder)\nLists/downloads via the shared folder link.\nFolder ID comes from `GOOGLE_DRIVE_FOLDER_ID`.\nDoes **not** use n8n Google Drive OAuth for media (that path returned SERVICE_DISABLED 403 even when OAuth showed connected).",
        "width": 320,
        "height": 240,
        "color": 1
      }
    }
