      "parameters": {
        "method": "POST",
        "url": "http://tracking-api:8081/products/17/platform-result",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ platform: 'pinterest', status: $json.status, post_id: $json.post_id || null, error_message: $json.error_message || null }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "72084d29-8306-569d-b6c9-801e11047d24",
      "name": "Live Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2600,
        0
      ],
      "parameters": {
        "jsCode": "const r = $('Pin Result').first().json;\nreturn [{ json: { product_id: r.product_id, pinterest: { status: r.status, post_id: r.post_id || null, url: r.url || null, error: r.error_message || null }, global_dry_run_unchanged: $('Load Config').first().json.dry_run } }];\n"
      }
    }
