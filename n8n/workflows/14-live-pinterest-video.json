      "position": [
        1400,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.pinterest.com/v5/media/' + $('Register Media').first().json.media_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "oAuth2Api": {
          "id": "oAuth2Api",
          "name": "Pinterest account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "000ea995-964c-5744-87fd-9d9c25ab1dd1",
      "name": "Media Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        0
      ],
      "parameters": {
        "jsCode": "const errText = (r) => r && (r.error || (r.code && r.message)) ? String((r.error && (r.error.description || r.error.message)) || r.message || JSON.stringify(r.error)).slice(0, 400) : null;\nconst reg = $('Register Media').first().json;\nconst up = $('S3 Upload').first().json;\nconst media = $json;\nconst attempt = $runIndex;\nconst firstErr = errText(reg) || (reg.media_id ? null : 'Register media returned no media_id: ' + JSON.stringify(reg).slice(0, 300))\n  || (up.ok ? null : 'S3 upload failed: ' + (up.error || up.status))\n  || errText(media);\nif (firstErr) return [{ json: { state: 'fail', error: firstErr } }];\nconst status = String(media.status || '');\nif (status === 'succeeded') return [{ json: { state: 'ready', attempt } }];\nif (status === 'failed') return [{ json: { state: 'fail', error: 'Pinterest video processing failed' } }];\nif (attempt >= 30) return [{ json: { state: 'fail', error: 'Pinterest processing timed out (' + status + ')' } }];\nreturn [{ json: { state: 'wait', attempt, status } }];\n"
      }
    },
