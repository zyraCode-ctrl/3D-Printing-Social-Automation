    {
      "id": "7d42d3e4-c25b-5d75-90dd-a114472a28ca",
      "name": "Prepare Pin Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "jsCode": "const pid = 17;\nconst config = $('Load Config').first().json;\nconst preview = $('Load Preview').first().json;\nconst record = $('Load Product').first().json;\nif (!preview || preview.error || !preview.content) throw new Error('No saved AI preview for Product ' + pid + '.');\nif (String(preview.media_type) !== 'video') throw new Error('Product ' + pid + ' is not a video.');\nif (record.pinterest_status === 'published' || record.pinterest_post_id) throw new Error('Product ' + pid + ' is already published on Pinterest. Refusing duplicate.');\nif (!config.pinterest_board_id) throw new Error('PINTEREST_BOARD_ID is missing.');\nconst p = preview.content.pinterest || {};\nconst tags = (p.hashtags || []).join(' ');\nlet description = [p.description, tags].filter(Boolean).join('\\n\\n');\nif (description.length > 800) description = description.slice(0, 797) + '...';\nreturn [{ json: {\n  product_id: pid,\n  board_id: config.pinterest_board_id,\n  filename: preview.filename,\n  title: String(p.title || '').slice(0, 100),\n  description,\n  alt_text: String(p.title || preview.vision_notes || '').slice(0, 500)\n} }];\n"
      }
    },
    {
      "id": "3ebcec1a-e177-59e0-921a-861f260eadf8",
      "name": "Register Media",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.pinterest.com/v5/media",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ media_type: 'video' }) }}"
      },
      "credentials": {
        "oAuth2Api": {
          "id": "oAuth2Api",
          "name": "Pinterest account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "53222d3d-bfb4-56a6-85bc-c9a750b271cf",
