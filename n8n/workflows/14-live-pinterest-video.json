        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ board_id: $('Prepare Pin Job').first().json.board_id, title: $('Prepare Pin Job').first().json.title, description: $('Prepare Pin Job').first().json.description, alt_text: $('Prepare Pin Job').first().json.alt_text, media_source: { source_type: 'video_id', media_id: $('Register Media').first().json.media_id, cover_image_key_frame_time: 1 } }) }}"
      },
      "credentials": {
        "oAuth2Api": {
          "id": "oAuth2Api",
          "name": "Pinterest account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "4628d536-5029-525d-9371-f12de97477b7",
      "name": "Pin Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        0
      ],
      "parameters": {
        "jsCode": "const errText = (r) => r && (r.error || (r.code && r.message)) ? String((r.error && (r.error.description || r.error.message)) || r.message || JSON.stringify(r.error)).slice(0, 400) : null;\nconst gate = $('Media Gate').last().json;\nlet pin = null;\ntry { pin = $('Create Pin').first().json; } catch (e) {}\nconst base = { product_id: $('Prepare Pin Job').first().json.product_id, platform: 'pinterest' };\nif (gate.state !== 'ready') return [{ json: { ...base, status: 'failed', error_message: gate.error } }];\nif (!pin || errText(pin) || !pin.id) return [{ json: { ...base, status: 'failed', error_message: errText(pin) || ('Create Pin returned no id: ' + JSON.stringify(pin).slice(0, 300)) } }];\nreturn [{ json: { ...base, status: 'published', post_id: pin.id, url: 'https://www.pinterest.com/pin/' + pin.id + '/' } }];\n"
      }
    },
    {
      "id": "663ede21-1245-5e2f-9b5a-aa6c76ccdc4b",
      "name": "Record Pinterest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
