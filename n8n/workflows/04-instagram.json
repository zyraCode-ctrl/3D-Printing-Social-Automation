    {
      "id": "ea116d00-c055-59a3-aed4-ccaf8ea93629",
      "name": "Page Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2080,
        -120
      ],
      "parameters": {
        "jsCode": "const expected = String($('Prepare Instagram Job').first().json.page_id || '');\nconst page = $('Get Page Token').first().json;\nconst me = $json;\nconst errText = (r) => r && r.error ? String(r.error.description || r.error.message || JSON.stringify(r.error)).slice(0, 300) : null;\nlet error = null;\nif (!expected) error = 'FACEBOOK_PAGE_ID is not configured';\nelse if (errText(page)) error = 'Cannot read Page ' + expected + ': ' + errText(page);\nelse if (String(page.id) !== expected) error = 'Page lookup returned ' + page.id + ', expected ' + expected;\nelse if (!page.access_token) error = 'No Page access token for ' + expected + ' (grant pages_show_list / pages_manage_posts for this Page)';\nelse if (errText(me)) error = 'Page token check failed: ' + errText(me);\nelse if (String(me.id) !== expected) error = 'Token acts as ' + me.name + ' (' + me.id + '), not Page ' + expected;\nreturn [{ json: { guard_ok: !error, error, page_id: expected, page_name: page.name || null } }];\n"
      }
