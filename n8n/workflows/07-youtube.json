    {
      "id": "b6d1cb68-4d76-5ba9-9653-973a35172c9d",
      "name": "Blocked Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        220
      ],
      "parameters": {
        "jsCode": "const job = $('When Called by Another Workflow').first().json;\nconst check = $json;\nreturn [{ json: {\n  product_id: job.product_id,\n  platform: 'youtube',\n  status: check.dry_run ? 'dry_run_skipped' : (check.status === 'published' ? 'published' : 'skipped'),\n  skipped: true,\n  reason: check.reason,\n  post_id: check.post_id || null\n} }];\n"
      }
    },
    {
      "id": "dc942339-0a51-5f38-8599-679f37db9d47",
      "name": "Load Config",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        760,
        -120
      ],
      "parameters": {
        "method": "GET",
        "url": "http://tracking-api:8081/config",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "af1814b7-685d-5ea0-919b-5443f58aa0fb",
      "name": "Load Preview",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        980,
        -120
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://tracking-api:8081/previews/' + $('When Called by Another Workflow').first().json.product_id }}",
        "options": {
