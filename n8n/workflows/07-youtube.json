    {
      "id": "d56b4ddd-0ff4-5c4e-90f3-59f700313e37",
      "name": "Upload YouTube Short",
      "type": "n8n-nodes-base.youTube",
      "typeVersion": 1,
      "position": [
        1940,
        -200
      ],
      "parameters": {
        "resource": "video",
        "operation": "upload",
        "title": "={{ $('Prepare Shorts Job').item.json.title }}",
        "regionCode": "US",
        "categoryId": "28",
        "binaryProperty": "data",
        "options": {
          "description": "={{ $('Prepare Shorts Job').item.json.description }}",
          "privacyStatus": "={{ $('Prepare Shorts Job').item.json.privacyStatus || 'private' }}",
          "tags": "={{ ($('Prepare Shorts Job').item.json.tags || []).join(',') }}"
        }
      },
      "credentials": {
        "youTubeOAuth2Api": {
          "id": "youTubeOAuth2Api",
          "name": "YouTube account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "615e8ece-5031-51e6-b648-5b68f2cc1e01",
      "name": "Interpret Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2180,
        -120
      ],
      "parameters": {
        "jsCode": "const prepared = $('Prepare Shorts Job').first().json;\nif (prepared.skip_upload) {\n  return [{ json: {\n    product_id: prepared.product_id,\n    platform: 'youtube',\n    status: 'skipped',\n    skipped: true,\n    reason: prepared.reason || 'YouTube Shorts require video media'\n  } }];\n}\nif (!prepared.local_path) {\n  return [{ json: {\n    product_id: prepared.product_id,\n    platform: 'youtube',\n    status: 'failed',\n    error_message: 'Missing local_path for Shorts video binary (product media from Drive).'\n  } }];\n}\nconst response = $json;\nconst postId = response.id || response.videoId || (response.snippet ? response.id : null);\nif (response.error || !postId) {\n  return [{ json: {\n    product_id: prepared.product_id,\n    platform: 'youtube',\n    status: 'failed',\n    error_message: (response.error && response.error.message) || response.message || JSON.stringify(response).slice(0, 500)\n  } }];\n}\nreturn [{ json: {\n  product_id: prepared.product_id,\n  platform: 'youtube',\n  status: 'published',\n  post_id: String(postId),\n  shorts: true\n} }];\n"
      }
    },
    {
