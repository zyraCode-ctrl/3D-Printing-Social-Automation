  "nodes": [
    {
      "id": "6a8d065f-b418-5e82-80eb-ae83064a82f9",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -380,
        -260
      ],
      "parameters": {
        "content": "## YouTube Shorts only (official YouTube Data API v3)\n\nThis automation publishes **YouTube Shorts only** \u2014 never long-form videos.\n\n- Video products from Google Drive are treated as Shorts.\n- Image-only products are skipped.\n- Default privacy is **private** for testing (`YOUTUBE_PRIVACY_STATUS=private`).\n- Description/hashtags include `#Shorts` for Shorts discovery.\n- Attach **YouTube OAuth2 API** credentials before any live run.\n- `DRY_RUN=true` stops at Duplicate Check \u2014 nothing is uploaded.\n",
        "width": 380,
        "height": 360,
        "color": 4
      }
    },
    {
      "id": "a9edb8c6-5f2d-5aee-8f0a-a01e08be3016",
