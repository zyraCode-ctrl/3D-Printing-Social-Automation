        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "3f8b1198-036b-5ff2-85ea-a71d433f33b5",
      "name": "Interpret Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2560,
        -120
      ],
      "parameters": {
        "jsCode": "const prepared = $('Prepare Facebook Job').first().json;\nconst guard = $('Page Guard').first().json;\nconst pageId = String(prepared.config.facebook_page_id);\nconst base = { product_id: prepared.product_id, platform: 'facebook' };\nconst errText = (r) => r && r.error ? String(r.error.description || r.error.message || JSON.stringify(r.error)).slice(0, 400) : null;\nif (!guard.guard_ok) return [{ json: { ...base, status: 'failed', error_message: 'Not posted: ' + guard.error } }];\nlet response = {};\nlet owner = {};\ntry { response = $('Publish Official API').first().json; } catch (e) {}\ntry { owner = $('Verify Post Owner').first().json; } catch (e) {}\nconst postId = response.post_id || response.id || null;\nif (errText(response) || !postId) {\n  return [{ json: { ...base, status: 'failed', error_message: errText(response) || ('No Facebook post id in response: ' + JSON.stringify(response).slice(0, 400)) } }];\n}\nconst ownerId = owner.from ? String(owner.from.id) : null;\nif (ownerId && ownerId !== pageId) {\n  return [{ json: { ...base, status: 'failed', post_id: String(postId), error_message: 'Posted as ' + owner.from.name + ' (' + ownerId + '), not Page ' + pageId + '. Delete it manually.' } }];\n}\nreturn [{ json: { ...base, status: 'published', post_id: String(postId), owner_verified: ownerId === pageId, permalink_url: owner.permalink_url || null } }];\n"
      }
    },
    {
      "id": "0c022beb-1004-5cb3-a843-b2c54b75c5a6",
      "name": "Store Platform Result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
