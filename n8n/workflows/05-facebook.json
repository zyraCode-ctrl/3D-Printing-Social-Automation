        "method": "GET",
        "url": "http://tracking-api:8081/config",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "a61e0f51-ceb3-5940-a36b-db473a363220",
      "name": "Load Preview",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        980,
        -120
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://tracking-api:8081/previews/' + $('When Called by Another Workflow').first().json.product_id }}",
        "options": {
