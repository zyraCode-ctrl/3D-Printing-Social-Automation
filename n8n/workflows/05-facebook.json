    },
    {
      "id": "bd0487b5-cc65-5b20-b455-1f2af4d6034b",
      "name": "Prepare Facebook Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        -120
      ],
      "parameters": {
        "jsCode": "const job = $('When Called by Another Workflow').first().json;\nconst config = $('Load Config').first().json;\nconst preview = $json;\nconst content = (preview && preview.content) || job.content || {};\nconst fb = content.facebook || {};\nif (!config.facebook_page_id) {\n  throw new Error('FACEBOOK_PAGE_ID is missing in .env / tracking config.');\n}\nconst message = [fb.caption, (fb.hashtags || []).join(' '), fb.cta].filter(Boolean).join('\\n\\n');\nconst driveId = preview.drive_file_id || job.drive_file_id || null;\nconst publicUrl = job.public_media_url\n  || (driveId ? ('https://drive.google.com/uc?export=download&id=' + driveId) : null);\nif (!publicUrl) {\n  throw new Error('No public_media_url / drive_file_id available for Facebook Graph publishing.');\n}\nconst isVideo = String(preview.media_type || job.media_type || '') === 'video'\n  || Boolean(job.video_file && !job.image_file)\n  || String(preview.media_type || '') === 'both';\nconst version = config.meta_graph_version || 'v22.0';\nconst pageId = config.facebook_page_id;\nconst edge = isVideo ? 'videos' : 'photos';\nconst body = isVideo\n  ? { description: message, file_url: publicUrl }\n  : { caption: message, url: publicUrl };\nreturn [{ json: {\n  product_id: job.product_id,\n  platform: 'facebook',\n  config,\n  preview,\n  content,\n  public_media_url: publicUrl,\n  drive_file_id: driveId,\n  publish_url: 'https://graph.facebook.com/' + version + '/' + pageId + '/' + edge,\n  publish_body: body\n} }];\n"
      }
    },
    {
      "id": "ed29ac89-4236-5ae5-907e-0e4101d79f8b",
      "name": "Get Page Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1340,
        -120
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://graph.facebook.com/' + ($('Prepare Facebook Job').first().json.config.meta_graph_version || 'v22.0') + '/' + $('Prepare Facebook Job').first().json.config.facebook_page_id + '?fields=id,name,access_token' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "facebookGraphApi",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "facebookGraphApi": {
          "id": "facebookGraphApi",
          "name": "Facebook Graph account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "e7ef3ba0-0134-520e-93bf-91ea62089c24",
      "name": "Verify Page Identity",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1520,
        -120
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://graph.facebook.com/' + ($('Prepare Facebook Job').first().json.config.meta_graph_version || 'v22.0') + '/me?fields=id,name' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'OAuth ' + ($('Get Page Token').first().json.access_token || 'missing') }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "8611db06-3dbe-55e3-ba8a-65eea3dda78e",
      "name": "Page Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1700,
        -120
      ],
      "parameters": {
        "jsCode": "const expected = String($('Prepare Facebook Job').first().json.config.facebook_page_id || '');\nconst page = $('Get Page Token').first().json;\nconst me = $json;\nconst errText = (r) => r && r.error ? String(r.error.description || r.error.message || JSON.stringify(r.error)).slice(0, 300) : null;\nlet error = null;\nif (!expected) error = 'FACEBOOK_PAGE_ID is not configured';\nelse if (errText(page)) error = 'Cannot read Page ' + expected + ': ' + errText(page);\nelse if (String(page.id) !== expected) error = 'Page lookup returned ' + page.id + ', expected ' + expected;\nelse if (!page.access_token) error = 'No Page access token for ' + expected + ' (grant pages_show_list / pages_manage_posts for this Page)';\nelse if (errText(me)) error = 'Page token check failed: ' + errText(me);\nelse if (String(me.id) !== expected) error = 'Token acts as ' + me.name + ' (' + me.id + '), not Page ' + expected;\nreturn [{ json: { guard_ok: !error, error, page_id: expected, page_name: page.name || null } }];\n"
      }
    },
    {
      "id": "177d412f-cf63-59e5-8b4c-352cd7af4708",
      "name": "Page Verified?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
