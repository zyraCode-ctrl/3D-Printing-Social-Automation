samples/*.jpg
samples/*.jpeg
samples/*.png
samples/*.webp
samples/*.mp4
samples/*.mov
!samples/.gitkeep
!samples/README.md

# Python
__pycache__/
*.pyc
.venv/
venv/

# n8n local dumps
n8n/tmp/
*.bak
